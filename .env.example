# Đổi tên file này thành .env (đặt cùng thư mục với run.bat / run.sh)

# Khóa API Claude: KHÔNG bắt buộc ở đây, nên nhập trong phần mềm (Cài đặt → Khóa API Claude).
# Khóa nhập trong phần mềm được ưu tiên. Để trống cả hai -> chế độ mô phỏng (nội dung mẫu, không tốn tiền)
ANTHROPIC_API_KEY=

# Mô hình Claude dùng cho các agent
CLAUDE_MODEL=claude-sonnet-5-5

# Múi giờ cho lịch họp
APP_TZ=Asia/Ho_Chi_Minh

# Cổng web
PORT=8000

# Phiên bản Facebook Graph API (đăng Fanpage)
FB_GRAPH_VERSION=v23.0

# Chỉ máy này truy cập được giao diện (an toàn vì phần mềm điều khiển nick Facebook)
HOST=127.0.0.1
